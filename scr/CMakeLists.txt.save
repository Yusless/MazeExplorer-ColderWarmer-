cmake_minimum_required(VERSION 3.10)
project(MazeExplorer)

# Список исходников (все .cpp лежат в scr/)
set(SOURCES
    scr/main.cpp
    scr/Game.cpp
    scr/InputHandler.cpp
    scr/CameraController.cpp
    scr/Renderer3D.cpp
    scr/MinimapRenderer.cpp
    scr/MazeGraph.cpp
    scr/Room.cpp
    scr/Wall.cpp
    scr/Floor.cpp
    scr/Door.cpp
)

add_executable(${PROJECT_NAME} ${SOURCES})

# Путь к заголовочным файлам (.h в include/)
target_include_directories(${PROJECT_NAME} PRIVATE 
    ${CMAKE_SOURCE_DIR}/include
)

# Подключаем raylib (он у вас уже в third_party)
# Если raylib собран как статическая библиотека в проекте, нужно добавить поддиректорию
# Но судя по вашей сборке, у вас уже есть third_party/raylib, и CMake его подключает.
# Добавим строчку для поиска raylib:
find_package(raylib REQUIRED)

target_link_libraries(${PROJECT_NAME} PRIVATE raylib)

if(WIN32)
    target_link_libraries(${PROJECT_NAME} PRIVATE winmm)
endif()

